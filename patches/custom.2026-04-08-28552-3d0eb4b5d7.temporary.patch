+void SetSpeedMode(const u8 mode) {
+    set_speed_limit = SpeedLimit();
+    const u16 standard_speed_limit = values.speed_limit.GetValue();
+    const u16 max_speed_limit = standard_speed_limit * 10;
+    const u16 min_speed_limit = (u16) ((double) standard_speed_limit * 0.1);
+    if (previous_set_mode != mode) {
+        previous_set_mode = mode;
+        if (!values.use_speed_limit.GetValue()) {
+            values.use_speed_limit.SetValue(true);
+        }
+    } else if (mode == 0) {
+        values.use_speed_limit.SetValue(!values.use_speed_limit.GetValue());
+    }
+
+    if (mode == 1) {
+        if (set_speed_limit < max_speed_limit) {
+            set_speed_limit = set_speed_limit + min_speed_limit;
+        }
+    } else if (mode == 2) {
+        if (set_speed_limit > min_speed_limit) {
+            set_speed_limit = set_speed_limit - min_speed_limit;
+        }
+    } else {
+        set_speed_limit = standard_speed_limit;
+    }
+
+    if (set_speed_limit > standard_speed_limit) {
+        current_mode = 1;
+    } else if (set_speed_limit < standard_speed_limit) {
+        current_mode = 2;
+    } else {
+        current_mode = 0;
+    }
