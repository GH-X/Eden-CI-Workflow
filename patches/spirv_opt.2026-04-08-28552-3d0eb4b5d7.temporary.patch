-+  # and link to the static SPIRV-Tools library.
-   set(SPIRV_TOOLS_LIBRARY_TYPE "STATIC")
--else(SPIRV_TOOLS_BUILD_STATIC)
--  set(SPIRV_TOOLS_FULL_VISIBILITY ${SPIRV_TOOLS})
--  if (NOT DEFINED SPIRV_TOOLS_LIBRARY_TYPE)
